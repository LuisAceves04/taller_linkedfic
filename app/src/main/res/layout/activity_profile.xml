<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F3F2EF">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Top Header Bar -->
        <View
            android:id="@+id/headerBar"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:background="#1B365D"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/ivHeaderLogo"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_marginStart="20dp"
            android:contentDescription="@string/app_name"
            android:scaleType="centerInside"
            android:src="@drawable/logofic"
            app:layout_constraintBottom_toBottomOf="@id/headerBar"
            app:layout_constraintStart_toStartOf="@id/headerBar"
            app:layout_constraintTop_toTopOf="@id/headerBar" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="@id/headerBar"
            app:layout_constraintEnd_toEndOf="@id/headerBar"
            app:layout_constraintTop_toTopOf="@id/headerBar">

            <TextView
                android:id="@+id/tvHeaderUsername"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:text=""
                android:textColor="@android:color/white"
                android:textSize="14sp"
                tools:text="Usuario" />

            <Button
                android:id="@+id/btnLogoutProfile"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:backgroundTint="@android:color/white"
                android:text="Cerrar Sesión"
                android:textColor="#1860A8"
                android:textSize="12sp"
                android:textStyle="bold"
                app:strokeColor="#1860A8"
                app:strokeWidth="1dp" />
        </LinearLayout>

        <!-- Main Profile Card Container -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardProfileContent"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="24dp"
            android:layout_marginEnd="24dp"
            android:layout_marginBottom="24dp"
            app:cardBackgroundColor="@android:color/white"
            app:cardCornerRadius="8dp"
            app:cardElevation="2dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/headerBar">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="24dp">

                <!-- Editar Perfil Button -->
                <Button
                    android:id="@+id/btnEditProfile"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:backgroundTint="#1860A8"
                    android:text="✏️ Editar Perfil"
                    android:textColor="@android:color/white"
                    android:textSize="12sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- Avatar Circle -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardAvatar"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:layout_marginTop="16dp"
                    app:cardBackgroundColor="#1860A8"
                    app:cardCornerRadius="36dp"
                    app:cardElevation="0dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/btnEditProfile">

                    <TextView
                        android:id="@+id/tvAvatarInitial"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text=""
                        android:textColor="@android:color/white"
                        android:textSize="32sp"
                        android:textStyle="bold"
                        tools:text="U" />

                    <!-- Agregamos este ImageView para mostrar la foto de perfil con Glide -->
                    <ImageView
                        android:id="@+id/ivAvatarProfile"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:contentDescription="Foto de perfil" />
                </com.google.android.material.card.MaterialCardView>

                <!-- Full Name -->
                <TextView
                    android:id="@+id/tvProfileName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text=""
                    android:textColor="#0B0404"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/cardAvatar"
                    tools:text="Nombre del Usuario" />

                <!-- Role Badge -->
                <TextView
                    android:id="@+id/tvProfileRoleBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="#6C757D"
                    android:paddingStart="12dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="4dp"
                    android:text="Alumno"
                    android:textColor="@android:color/white"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvProfileName" />

                <!-- SECTION 1: INFORMACIÓN ACADÉMICA -->
                <TextView
                    android:id="@+id/tvSectionAcademic"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:text="🎓 INFORMACIÓN ACADÉMICA"
                    android:textColor="#1860A8"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvProfileRoleBadge" />

                <!-- Carrera / Programa -->
                <TextView
                    android:id="@+id/tvLabelMajorTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Carrera / Programa"
                    android:textColor="#666666"
                    android:textSize="14sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvSectionAcademic" />

                <TextView
                    android:id="@+id/tvProfileMajorValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="#0B0404"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/tvLabelMajorTitle"
                    tools:text="Carrera / Programa" />

                <!-- Semestre / Año -->
                <TextView
                    android:id="@+id/tvLabelSemesterTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Semestre / Año"
                    android:textColor="#666666"
                    android:textSize="14sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvLabelMajorTitle" />

                <TextView
                    android:id="@+id/tvProfileSemesterValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="#0B0404"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/tvLabelSemesterTitle"
                    tools:text="1" />

                <!-- Divider 1 -->
                <View
                    android:id="@+id/divider1"
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_marginTop="16dp"
                    android:background="#E0E0E0"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvLabelSemesterTitle" />

                <!-- SECTION 2: INFORMACIÓN GENERAL -->
                <TextView
                    android:id="@+id/tvSectionGeneral"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="👤 INFORMACIÓN GENERAL"
                    android:textColor="#1860A8"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/divider1" />

                <!-- Correo Electrónico -->
                <TextView
                    android:id="@+id/tvLabelEmailTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Correo Electrónico"
                    android:textColor="#666666"
                    android:textSize="14sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvSectionGeneral" />

                <TextView
                    android:id="@+id/tvProfileEmailValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="#0B0404"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/tvLabelEmailTitle"
                    tools:text="correo@ejemplo.com" />

                <!-- Teléfono -->
                <TextView
                    android:id="@+id/tvLabelPhoneTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Teléfono"
                    android:textColor="#666666"
                    android:textSize="14sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvLabelEmailTitle" />

                <TextView
                    android:id="@+id/tvProfilePhoneValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="#0B0404"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/tvLabelPhoneTitle"
                    tools:text="Teléfono" />

                <!-- Sobre Mí -->
                <TextView
                    android:id="@+id/tvLabelAboutTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Sobre Mí"
                    android:textColor="#666666"
                    android:textSize="14sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvLabelPhoneTitle" />

                <TextView
                    android:id="@+id/tvProfileAboutValue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:gravity="end"
                    android:text=""
                    android:textColor="#0B0404"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/tvLabelAboutTitle"
                    app:layout_constraintTop_toTopOf="@id/tvLabelAboutTitle"
                    tools:text="Sobre mí..." />

                <!-- Divider 2 -->
                <View
                    android:id="@+id/divider2"
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_marginTop="16dp"
                    android:background="#E0E0E0"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvProfileAboutValue" />

                <!-- SECTION 3: HABILIDADES -->
                <TextView
                    android:id="@+id/tvSectionSkills"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="🛠️ HABILIDADES"
                    android:textColor="#1860A8"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/divider2" />

                <Button
                    android:id="@+id/btnAddSkill"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:backgroundTint="#1860A8"
                    android:text="+ Agregar"
                    android:textColor="@android:color/white"
                    android:textSize="10sp"
                    app:layout_constraintBottom_toBottomOf="@id/tvSectionSkills"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/tvSectionSkills" />

                <TextView
                    android:id="@+id/tvProfileSkillsValue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text=""
                    android:textColor="#0B0404"
                    android:textSize="14sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvSectionSkills"
                    tools:text="Java, Kotlin, Laravel, Android" />

                <!-- Divider 3 -->
                <View
                    android:id="@+id/divider3"
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_marginTop="16dp"
                    android:background="#E0E0E0"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvProfileSkillsValue" />

                <!-- SECTION 4: DOCUMENTACIÓN -->
                <TextView
                    android:id="@+id/tvSectionDocs"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="📁 DOCUMENTACIÓN"
                    android:textColor="#1860A8"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/divider3" />

                <!-- Currículum Vitae -->
                <TextView
                    android:id="@+id/tvLabelCvTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Currículum Vitae"
                    android:textColor="#666666"
                    android:textSize="14sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvSectionDocs" />

                <Button
                    android:id="@+id/btnDownloadCv"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:backgroundTint="#FFFFFF"
                    android:text="📄 Ver / Descargar CV"
                    android:textColor="#1860A8"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/tvLabelCvTitle"
                    app:strokeColor="#1860A8"
                    app:strokeWidth="1dp" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>