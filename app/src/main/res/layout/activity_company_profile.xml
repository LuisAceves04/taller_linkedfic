<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3F2EF"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/headerBarEmpresa"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="@color/azul_oscuro"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <ImageView
                android:id="@+id/ivHeaderLogoEmpresa"
                android:layout_width="82dp"
                android:layout_height="82dp"
                android:contentDescription="@string/app_name"
                android:scaleType="centerInside"
                android:src="@drawable/logofic"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tvHeaderUsernameEmpresa"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:textColor="@android:color/white"
                android:textSize="13sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/btnLogoutProfileEmpresa"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="Empresa" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLogoutProfileEmpresa"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="Cerrar sesión"
                android:textColor="@color/azul_oscuro"
                android:textSize="11sp"
                android:textStyle="bold"
                app:backgroundTint="@android:color/white"
                app:cornerRadius="20dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardProfileContentEmpresa"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="18dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="24dp"
            app:cardBackgroundColor="@android:color/white"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/layoutCompanyHero"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/azul_oscuro"
                    android:minHeight="232dp"
                    android:paddingStart="20dp"
                    android:paddingTop="18dp"
                    android:paddingEnd="20dp"
                    android:paddingBottom="20dp">

                    <TextView
                        android:id="@+id/tvPublicCompanyPreviewLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@color/dorado_oro_uas"
                        android:paddingStart="12dp"
                        android:paddingTop="6dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="6dp"
                        android:text="PERFIL DE ORGANIZACIÓN"
                        android:textColor="@android:color/white"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardAvatarEmpresa"
                        android:layout_width="88dp"
                        android:layout_height="88dp"
                        android:layout_marginTop="14dp"
                        app:cardBackgroundColor="@android:color/white"
                        app:cardCornerRadius="44dp"
                        app:cardElevation="2dp"
                        app:strokeColor="#E5EAF0"
                        app:strokeWidth="2dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tvPublicCompanyPreviewLabel">

                        <TextView
                            android:id="@+id/tvAvatarInitialEmpresa"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:textColor="@color/azul_institucional"
                            android:textSize="32sp"
                            android:textStyle="bold"
                            tools:text="E" />

                        <ImageView
                            android:id="@+id/ivAvatarProfileEmpresa"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="Logotipo de la empresa"
                            android:scaleType="centerCrop" />
                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:id="@+id/tvProfileNameEmpresa"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center"
                        android:textColor="@android:color/white"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/cardAvatarEmpresa"
                        tools:text="Nombre de la organización" />

                    <TextView
                        android:id="@+id/tvProfileRoleBadgeEmpresa"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:background="#FFFFFF"
                        android:paddingStart="12dp"
                        android:paddingTop="4dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="4dp"
                        android:text="Empresa"
                        android:textColor="@color/azul_oscuro"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tvProfileNameEmpresa" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Botón Editar Perfil -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnEditProfileEmpresa"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="Editar perfil de empresa"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:backgroundTint="@color/azul_institucional"
                        app:cornerRadius="10dp"
                        app:icon="@android:drawable/ic_menu_edit"
                        app:iconTint="@android:color/white" />

                    <!-- Botón Enviar Mensaje -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSendMessageEmpresa"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="8dp"
                        android:text="✉️ Enviar Mensaje"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:visibility="gone"
                        app:backgroundTint="@color/azul_institucional"
                        app:cornerRadius="10dp"
                        app:iconTint="@android:color/white" />

                    <TextView
                        android:id="@+id/tvSectionAboutEmpresa"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:text="Acerca de la organización"
                        android:textColor="@color/azul_institucional"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvProfileAboutEmpresaValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:lineSpacingExtra="3dp"
                        android:textColor="#3F4852"
                        android:textSize="14sp"
                        tools:text="Conoce nuestra misión, nuestro equipo y las oportunidades que ofrecemos a la comunidad." />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="20dp"
                        android:background="#E5EAF0" />

                    <TextView
                        android:id="@+id/tvSectionCorporate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:text="Información corporativa"
                        android:textColor="@color/azul_institucional"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:id="@+id/rowIndustryEmpresa"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:contentDescription="@null"
                            android:src="@android:drawable/ic_menu_agenda"
                            app:tint="@color/dorado_oro_uas" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvLabelIndustryTitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Industria o sector"
                                android:textColor="#707A84"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/tvProfileIndustryValue"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:textColor="@color/azul_oscuro"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                tools:text="Tecnología de la información" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/rowWebsiteEmpresa"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:contentDescription="@null"
                            android:src="@android:drawable/ic_menu_view"
                            app:tint="@color/dorado_oro_uas" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvLabelWebTitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Sitio web"
                                android:textColor="#707A84"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/tvProfileWebValue"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:ellipsize="end"
                                android:maxLines="2"
                                android:textColor="@color/azul_institucional"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                tools:text="https://www.empresa.com" />
                        </LinearLayout>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="20dp"
                        android:background="#E5EAF0" />

                    <TextView
                        android:id="@+id/tvSectionContact"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:text="Contacto"
                        android:textColor="@color/azul_institucional"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:id="@+id/rowEmailEmpresa"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:contentDescription="@null"
                            android:src="@android:drawable/ic_dialog_email"
                            app:tint="@color/dorado_oro_uas" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvLabelEmailEmpresaTitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Correo electrónico"
                                android:textColor="#707A84"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/tvProfileEmailEmpresaValue"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:textColor="@color/azul_oscuro"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                tools:text="contacto@empresa.com" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/rowPhoneEmpresa"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:contentDescription="@null"
                            android:src="@android:drawable/ic_menu_call"
                            app:tint="@color/dorado_oro_uas" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvLabelPhoneEmpresaTitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Teléfono"
                                android:textColor="#707A84"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/tvProfilePhoneEmpresaValue"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:textColor="@color/azul_oscuro"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                tools:text="+52 667 123 4567" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvCompanyPublicFooter"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:background="#F3F6FA"
                        android:gravity="center"
                        android:padding="12dp"
                        android:text="Información de la organización visible para candidatos y comunidad."
                        android:textColor="#687583"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>