<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scrollRegisterCompany"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@android:color/white">



    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <TextView
            android:id="@+id/tvTitleRegisterCompany"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/title_register_company"
            android:textColor="#0B0404"
            android:textSize="26sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvSubtitleRegisterCompany"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/subtitle_register_company"
            android:textColor="#666666"
            android:textSize="14sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvTitleRegisterCompany" />

        <!-- Nombre de la Empresa -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardCompanyName"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="24dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="10dp"
            app:strokeColor="#3A3A3A"
            app:strokeWidth="1.5dp"
            app:layout_constraintTop_toBottomOf="@id/tvSubtitleRegisterCompany">

            <EditText
                android:id="@+id/etCompanyName"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@null"
                android:hint="@string/hint_company_name"
                android:inputType="text"
                android:maxLines="1"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="#0A66C2"
                android:textColorHint="#666666"
                android:textSize="16sp" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Correo Electrónico Corporativo -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardCompanyEmail"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="10dp"
            app:strokeColor="#3A3A3A"
            app:strokeWidth="1.5dp"
            app:layout_constraintTop_toBottomOf="@id/cardCompanyName">

            <EditText
                android:id="@+id/etCompanyEmail"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@null"
                android:hint="@string/hint_corp_email"
                android:inputType="textEmailAddress"
                android:maxLines="1"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="#0A66C2"
                android:textColorHint="#666666"
                android:textSize="16sp" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Contraseña -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardCompanyPassword"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="10dp"
            app:strokeColor="#3A3A3A"
            app:strokeWidth="1.5dp"
            app:layout_constraintTop_toBottomOf="@id/cardCompanyEmail">

            <EditText
                android:id="@+id/etCompanyPassword"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@null"
                android:hint="@string/hint_password_req"
                android:inputType="textPassword"
                android:maxLines="1"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="#0A66C2"
                android:textColorHint="#666666"
                android:textSize="16sp" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Descripción / Presentación (Opcional) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardCompanyDescription"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="10dp"
            app:strokeColor="#3A3A3A"
            app:strokeWidth="1.5dp"
            app:layout_constraintTop_toBottomOf="@id/cardCompanyPassword">

            <EditText
                android:id="@+id/etCompanyDescription"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@null"
                android:gravity="top|start"
                android:hint="@string/hint_company_desc"
                android:inputType="textMultiLine"
                android:padding="16dp"
                android:textColor="#0A66C2"
                android:textColorHint="#666666"
                android:textSize="15sp" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Spinner Industria / Sector -->
        <TextView
            android:id="@+id/tvLabelIndustry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/label_select_industry"
            android:textColor="#191919"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cardCompanyDescription" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardCompanyIndustry"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="6dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="10dp"
            app:strokeColor="#3A3A3A"
            app:strokeWidth="1.5dp"
            app:layout_constraintTop_toBottomOf="@id/tvLabelIndustry">

            <Spinner
                android:id="@+id/spIndustries"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingStart="8dp"
                android:paddingEnd="8dp" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Botón Registrarse -->
        <Button
            android:id="@+id/btnRegisterCompany"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="28dp"
            android:backgroundTint="@color/azul_institucional"
            android:text="@string/btn_create_company_account"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/cardCompanyIndustry" />

        <ProgressBar
            android:id="@+id/progressBarCompany"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:visibility="gone"
            android:indeterminateTint="@color/azul_institucional"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnRegisterCompany" />

        <TextView
            android:id="@+id/tvBackToLoginFromCompany"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:clickable="true"
            android:focusable="true"
            android:minHeight="48dp"
            android:text="@string/back_to_login_prompt"
            android:textColor="@color/azul_institucional"
            android:textSize="15sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/progressBarCompany" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
