<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardBackgroundColor="@android:color/white"
    app:cardCornerRadius="20dp"
    app:cardElevation="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="42dp"
                android:layout_height="42dp"
                app:cardBackgroundColor="#FFF5E5"
                app:cardCornerRadius="21dp"
                app:cardElevation="0dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:padding="10dp"
                    android:src="@android:drawable/ic_dialog_alert"
                    app:tint="@color/dorado_oro_uas" />
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tvDeleteEmploymentOfferHeader"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="Gestionar vacante"
                android:textColor="@color/azul_oscuro"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvDeleteEmploymentOfferMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:lineSpacingExtra="2dp"
            android:text="Puedes cerrar esta vacante o eliminarla definitivamente."
            android:textColor="#596675"
            android:textSize="14sp" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardEmploymentOfferDeletePreview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="#F6F8FA"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeColor="#E5EAF0"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:id="@+id/tvEmploymentOfferDeleteTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/azul_oscuro"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    tools:text="Diseñador(a) de producto" />

                <TextView
                    android:id="@+id/tvEmploymentOfferDeleteDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:ellipsize="end"
                    android:maxLines="3"
                    android:textColor="#4F5B67"
                    android:textSize="13sp"
                    tools:text="Buscamos talento para colaborar con nuestro equipo de diseño y producto." />

                <TextView
                    android:id="@+id/tvEmploymentOfferDeleteDetails"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/azul_institucional"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    tools:text="Modalidad híbrida · $15,000–$20,000" />

                <ImageView
                    android:id="@+id/ivEmploymentOfferDeletePreview"
                    android:layout_width="match_parent"
                    android:layout_height="112dp"
                    android:layout_marginTop="8dp"
                    android:contentDescription="Imagen de la oferta de empleo"
                    android:scaleType="centerCrop"
                    android:visibility="gone"
                    tools:visibility="visible" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCloseEmploymentOffer"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="18dp"
            android:text="Cerrar vacante"
            android:textColor="@color/azul_institucional"
            android:textStyle="bold"
            app:cornerRadius="12dp"
            app:strokeColor="@color/azul_institucional" />

        <TextView
            android:id="@+id/tvDeleteEmploymentOfferHelp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="La oferta dejará de mostrarse como disponible."
            android:textColor="#77828D"
            android:textSize="12sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDeleteEmploymentOffer"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:text="Eliminar definitivamente"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            app:backgroundTint="#B42318"
            app:cornerRadius="12dp"
            app:icon="@android:drawable/ic_menu_delete"
            app:iconTint="@android:color/white" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelDeleteEmploymentOffer"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="4dp"
            android:text="Cancelar"
            android:textColor="#65717D" />

        <!-- IDs empleados para localizar la oferta y confirmar acciones. -->
        <TextView
            android:id="@+id/tvDeleteEmploymentOfferId"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvDeleteEmploymentOfferCompanyId"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>