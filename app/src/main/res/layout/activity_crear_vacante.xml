<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3F2EF"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp">

        <TextView
            android:id="@+id/tvTituloCrearVacante"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="💼 Publicar Nueva Vacante"
            android:textColor="#1B365D"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilTituloVacante"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:hint="Título del puesto"
            app:boxStrokeColor="#0A66C2"
            app:layout_constraintTop_toBottomOf="@id/tvTituloCrearVacante">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etTituloVacante"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapSentences" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilDescripcionVacante"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Descripción y requisitos"
            app:boxStrokeColor="#0A66C2"
            app:layout_constraintTop_toBottomOf="@id/tilTituloVacante">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etDescripcionVacante"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top"
                android:inputType="textMultiLine"
                android:minLines="4" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Campo de modalidad -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilModalidadVacante"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Selecciona una Modalidad"
            app:boxStrokeColor="#0A66C2"
            app:layout_constraintTop_toBottomOf="@id/tilDescripcionVacante">

            <AutoCompleteTextView
                android:id="@+id/actvModalidadVacante"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none" />
        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout
            android:id="@+id/llSueldos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp"
            android:baselineAligned="false"
            app:layout_constraintTop_toBottomOf="@id/tilModalidadVacante">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilSalarioMinVacante"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:hint="Sueldo Mín."
                app:boxStrokeColor="#0A66C2">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etSalarioMinVacante"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilSalarioMaxVacante"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:hint="Sueldo Máx."
                app:boxStrokeColor="#0A66C2">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etSalarioMaxVacante"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <!-- Vista previa de imagen -->
        <ImageView
            android:id="@+id/ivPreviewImagenVacante"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_marginTop="12dp"
            android:scaleType="centerCrop"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/llSueldos" />

        <!-- Vista previa de video -->
        <VideoView
            android:id="@+id/vvPreviewVideoVacante"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_marginTop="12dp"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/ivPreviewImagenVacante"/>

        <!-- Botones para seleccionar multimedia -->
        <LinearLayout
            android:id="@+id/llBotonesMultimedia"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/vvPreviewVideoVacante">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSeleccionarImagenVacante"
                style="@style/Widget.MaterialComponents.Button.TextButton.Icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Foto"
                android:textColor="#536471"
                app:iconTint="#0A66C2"
                app:icon="@android:drawable/ic_menu_gallery" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSeleccionarVideoVacante"
                style="@style/Widget.MaterialComponents.Button.TextButton.Icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Video"
                android:textColor="#536471"
                app:iconTint="#D32F2F"
                app:icon="@android:drawable/ic_media_play" />
        </LinearLayout>

        <Button
            android:id="@+id/btnGuardarVacante"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="24dp"
            android:backgroundTint="#0A66C2"
            android:text="Publicar Vacante"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="10dp"
            app:layout_constraintTop_toBottomOf="@id/llBotonesMultimedia"
            app:layout_constraintBottom_toBottomOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>