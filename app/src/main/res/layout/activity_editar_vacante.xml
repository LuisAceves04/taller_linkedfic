<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3F2EF"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp">

        <TextView
            android:id="@+id/tvTituloEditarVacante"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Editar Vacante"
            android:textColor="#1B365D"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Título -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilEditarTituloVacante"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:hint="Título del puesto"
            app:boxStrokeColor="#0A66C2"
            app:layout_constraintTop_toBottomOf="@id/tvTituloEditarVacante">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etEditarTituloVacante"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapSentences" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Descripción -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilEditarDescripcionVacante"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Descripción y requisitos"
            app:boxStrokeColor="#0A66C2"
            app:layout_constraintTop_toBottomOf="@id/tilEditarTituloVacante">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etEditarDescripcionVacante"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top"
                android:inputType="textMultiLine"
                android:minLines="4" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Modalidad desplegable -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilEditarModalidadVacante"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Selecciona una Modalidad"
            app:boxStrokeColor="#0A66C2"
            app:layout_constraintTop_toBottomOf="@id/tilEditarDescripcionVacante">

            <AutoCompleteTextView
                android:id="@+id/actvEditarModalidadVacante"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Contenedor de Sueldos -->
        <LinearLayout
            android:id="@+id/llEditarSueldos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp"
            android:baselineAligned="false"
            app:layout_constraintTop_toBottomOf="@id/tilEditarModalidadVacante">

            <!-- Sueldo Mínimo -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilEditarSalarioMin"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:hint="Sueldo Mín."
                app:boxStrokeColor="#0A66C2">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etEditarSalarioMinVacante"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Sueldo Máximo -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilEditarSalarioMax"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:hint="Sueldo Máx."
                app:boxStrokeColor="#0A66C2">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etEditarSalarioMaxVacante"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <!-- Vista previa de imagen -->
        <ImageView
            android:id="@+id/ivEditarPreviewImagenVacante"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_marginTop="12dp"
            android:scaleType="centerCrop"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/llEditarSueldos" />

        <!-- Vista previa de video -->
        <VideoView
            android:id="@+id/vvEditarPreviewVideoVacante"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_marginTop="12dp"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/ivEditarPreviewImagenVacante"/>

        <!-- Botones multimedia -->
        <LinearLayout
            android:id="@+id/llEditarBotonesMultimedia"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/vvEditarPreviewVideoVacante">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEditarSeleccionarImagenVacante"
                style="@style/Widget.MaterialComponents.Button.TextButton.Icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cambiar Foto"
                android:textColor="#536471"
                app:iconTint="#0A66C2"
                app:icon="@android:drawable/ic_menu_gallery" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEditarSeleccionarVideoVacante"
                style="@style/Widget.MaterialComponents.Button.TextButton.Icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cambiar Video"
                android:textColor="#536471"
                app:iconTint="#D32F2F"
                app:icon="@android:drawable/ic_media_play" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="24dp"
            app:layout_constraintTop_toBottomOf="@id/llEditarBotonesMultimedia"
            app:layout_constraintBottom_toBottomOf="parent">

            <Button
                android:id="@+id/btnCancelarEditarVacante"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="Cancelar"
                android:textColor="#D32F2F"
                app:strokeColor="#D32F2F"
                app:cornerRadius="10dp" />

            <Button
                android:id="@+id/btnGuardarEditarVacante"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:backgroundTint="#0A66C2"
                android:text="Guardar"
                android:textSize="16sp"
                android:textStyle="bold"
                app:cornerRadius="10dp" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>