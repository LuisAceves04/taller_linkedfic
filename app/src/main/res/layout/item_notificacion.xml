<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="12dp"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp"
    android:background="@android:color/white"
    android:gravity="center_vertical"
    android:elevation="1dp">

    <!-- Avatar de la empresa (Diseño circular estándar) -->
    <ImageView
        android:id="@+id/ivEmpresaAvatar"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:scaleType="centerCrop"
        android:src="@android:drawable/ic_menu_myplaces"
        android:contentDescription="Avatar Empresa" />

    <!-- Textos de la notificación -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvMensajeNotif"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="A la empresa le interesa tu perfil."
            android:textColor="#0B0404"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvFechaNotif"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Hace 5 minutos"
            android:textColor="#666666"
            android:textSize="12sp" />
    </LinearLayout>

</LinearLayout>