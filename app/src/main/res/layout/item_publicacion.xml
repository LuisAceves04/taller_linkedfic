<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="14dp"
    android:layout_marginVertical="10dp"
    app:cardCornerRadius="18dp"
    app:cardElevation="3dp"
    android:backgroundTint="@color/white"
    app:strokeColor="#F0F0F0"
    app:strokeWidth="1.5dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="16dp"
        android:paddingBottom="16dp">

        <!-- CABECERA: Avatar, Autor y Botones de Edición -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp">

            <!-- Avatar circular -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="50dp"
                android:layout_height="50dp"
                app:cardCornerRadius="25dp"
                app:cardElevation="0dp"
                app:strokeColor="#0A66C2"
                app:strokeWidth="2.5dp">

                <ImageView
                    android:id="@+id/ivAvatarAutor"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:padding="2dp"
                    android:src="@mipmap/ic_launcher_round"
                    android:contentDescription="Avatar del usuario" />
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="14dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvNombreAutor"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Nombre del Usuario"
                    android:textStyle="bold"
                    android:textColor="#0F1419"
                    android:textSize="16sp"
                    android:maxLines="1"
                    android:ellipsize="end"/>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="#F2F4F7"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="3dp"
                    android:layout_marginTop="4dp">

                    <TextView
                        android:id="@+id/tvTiempoPost"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Hace un momento"
                        android:textColor="#536471"
                        android:textStyle="bold"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Botones de Acción (Editar y Eliminar) -->
            <ImageButton
                android:id="@+id/btnEditarPost"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_edit"
                app:tint="#0A66C2"
                android:visibility="gone"
                android:contentDescription="Editar publicación" />

            <ImageButton
                android:id="@+id/btnEliminarPost"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_delete"
                app:tint="#D32F2F"
                android:visibility="gone"
                android:contentDescription="Eliminar publicación" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E1E8ED"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="14dp"
            android:layout_marginHorizontal="16dp"/>

        <!-- CUERPO DE LA PUBLICACIÓN -->
        <TextView
            android:id="@+id/tvTituloPost"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="18dp"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="#0F1419"
            android:letterSpacing="-0.01"/>

        <TextView
            android:id="@+id/tvContenidoPost"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:paddingHorizontal="18dp"
            android:textSize="15sp"
            android:textColor="#333333"
            android:lineSpacingExtra="4dp"/>

        <!-- Vista de Imagen -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivImagenPost"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:maxHeight="260dp"
            android:layout_marginTop="16dp"
            android:layout_marginHorizontal="18dp"
            android:scaleType="centerCrop"
            android:visibility="gone"
            android:contentDescription="Imagen de la publicación"
            app:shapeAppearanceOverlay="@style/RoundedImageStyle"/>

        <!-- Vista de Video -->
        <VideoView
            android:id="@+id/vvVideoPost"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_marginTop="16dp"
            android:layout_marginHorizontal="18dp"
            android:visibility="gone" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>